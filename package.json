{
  "name": "sql-inv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "seed": "node src/db/seed.js",
    "seed:postgres": "node src/db/seed-postgres.js",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:dsl": "vitest run tests/dsl",
    "test:db": "vitest run tests/db",
    "test:frontend": "vitest run tests/frontend",
    "test:api": "vitest run tests/api"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "chart.js": "^4.5.1",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.2",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.4",
    "vitest": "^5.1.2"
  }
}
